+def _validated_bulk_pdf_options(options) -> dict:
+	"""Accept page settings, never arbitrary renderer process arguments."""
+	if isinstance(options, str):
+		try:
+			options = json.loads(options)
+		except (ValueError, TypeError):
+			frappe.throw(_("Invalid PDF options"))
+	if options is None:
+		return {}
+	allowed = {"page-size", "page-height", "page-width", "orientation", "password"}
+	if not isinstance(options, dict) or set(options) - allowed:
+		frappe.throw(_("Unsupported PDF options"))
+	paper_sizes = {f"{series}{number}" for series in ("A", "B") for number in range(11)}
+	paper_sizes.update({"C5E", "Comm10E", "DLE", "Executive", "Folio", "Ledger", "Legal", "Letter", "Tabloid", "Custom"})
+	if "page-size" in options and (not isinstance(options["page-size"], str) or options["page-size"] not in paper_sizes):
+		frappe.throw(_("Invalid PDF page size"))
+	if "orientation" in options and options["orientation"] not in ("Portrait", "Landscape"):
+		frappe.throw(_("Invalid PDF orientation"))
+	for key in ("page-height", "page-width"):
+		if key not in options:
+			continue
+		value = options[key]
+		if type(value) in (int, float):
+			millimetres = value
+		elif isinstance(value, str) and (match := re.fullmatch(r"(\d+(?:\.\d+)?|\.\d+)(mm|cm|in|pt|px)?", value)):
+			millimetres = float(match[1]) * {None: 1, "mm": 1, "cm": 10, "in": 25.4, "pt": 25.4 / 72, "px": 25.4 / 96}[match[2]]
+		else:
+			frappe.throw(_("Invalid PDF page dimensions"))
+		if not 0 < millimetres <= 2000:
+			frappe.throw(_("PDF page dimensions must be between 0 and 2000 mm"))
+	if "password" in options and (not isinstance(options["password"], str) or len(options["password"]) > 256):
+		frappe.throw(_("Invalid PDF password"))
+	return dict(options)
 
 
